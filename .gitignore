# ============================================
# Proyecto Tlatoa — .gitignore
# ============================================

# --- Secretos y entorno local ---
.env
.env.*
!.env.example
storage/raw/cookie.txt
*.cookie

# --- Datos crudos y Fotos (distribuidas externamente vía Drive/Mediafire) ---
storage/raw/html/
storage/raw/*.txt
storage/raw/*.html
storage/raw/*.zip
storage/raw/*.json
storage/raw/photos/*
!storage/raw/photos/.gitkeep

# --- Reportes locales y OSINT generados ---
storage/*.html
storage/*.pdf
storage/reporte_*

# --- Herramientas privadas y bots locales ---
tools/private/

# --- Logs ---
storage/logs/*
!storage/logs/.gitkeep
*.log
*.jsonl

# --- Legacy / respaldos ---
index.old.php
*.bak
*.old
*.orig
*~

# --- Dependencias (si se agregan en el futuro) ---
/vendor/
/node_modules/

# --- IDE / SO ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Caché de herramientas y aplicación ---
.phpunit.cache/
.phpstan.cache/
storage/cache/*
!storage/cache/.gitkeep

# --- Python y entorno virtual ---
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/
*.egg
*.whl
.coverage
.coverage.*
htmlcov/
storage/electoral/actas/*
!storage/electoral/actas/.gitkeep
tor_keys/

# --- Rust y Cargo Build ---
target/
**/target/
*.rs.bk
*.rlib
*.rmeta

# --- Binarios compilados y ejecutables nativos ---
/tlatoa-desktop
/tlatoa-desktop.exe
/tlatoa
/tlatoa.exe
*.exe
*.out
*.bin
*.app
*.elf

# --- Objetos y librerías compiladas (C / C++ / FFI / Shared Objects) ---
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.pdb
*.idb

# --- Android / Mobile Builds y Paquetes precompilados ---
.gradle/
*.apk
*.aab
*.ap_
*.dex
*.class
*.jar
*.aar
local.properties

# --- Bases de datos binarias compiladas y cachés SQLite ---
storage/*.db
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal

~/crates/
crates/tlatoa-core/Cargo.toml
